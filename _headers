# ============================================================================
# Cache de longa duração para imagens e assets estáticos (Cloudflare Pages).
# Coloque este arquivo na RAIZ do site (mesmo nível do index.html).
# O Cloudflare Pages lê o arquivo "_headers" automaticamente.
#
# max-age=31536000 = 1 ano. "immutable" diz ao navegador para nem checar de novo.
# Isso faz as imagens carregarem instantaneamente na 2ª visita.
# ============================================================================

# Imagens
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos servidas pelo proxy do CRM
/cdn-fotos/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS (se houver arquivos separados)
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# PDFs de mapas: visualização inline, sem sugestão de download e sem indexação direta.
/*.pdf
  Content-Disposition: inline
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, noarchive

# A homepage é pública e pode ser servida pela borda por poucos minutos.
# O navegador continua revalidando (max-age=0), enquanto o s-maxage reduz o TTFB
# sem colocar o CRM ou as páginas de detalhe em cache de longa duração.
/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=600
# As demais páginas HTML continuam sempre revalidando.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Headers gerais de segurança
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.facebook.com https://graph.facebook.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com; form-action 'self' https://wa.me https://api.whatsapp.com; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=()
