# ============================================================================
# Cache de longa duração para imagens e assets estáticos (Cloudflare Pages).
# Coloque este arquivo na RAIZ do site (mesmo nível do index.html).
# O Cloudflare Pages lê o arquivo "_headers" automaticamente.
#
# max-age=31536000 = 1 ano. "immutable" diz ao navegador para nem checar de novo.
# Isso faz as imagens carregarem instantaneamente na 2ª visita.
# ============================================================================

# Imagens
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos servidas pelo proxy do CRM
/cdn-fotos/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS (se houver arquivos separados)
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# PDFs de mapas: visualização inline, sem sugestão de download e sem indexação direta.
/*.pdf
  Content-Disposition: inline
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, noarchive

# As páginas HTML não devem ter cache longo no navegador, mas as cinco rotas
# estáticas auditadas podem ser servidas pela borda por alguns minutos. Isto
# reduz TTFB sem congelar conteúdo por longos períodos; novos deploys do Pages
# continuam a invalidar a versão publicada.
/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
/capao-da-canoa-arroio-teixeira/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
/comprar-na-planta-ou-pronto/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
/condominio-maquine-la-marina/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
/osorio/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

# Outras páginas HTML continuam a revalidar sempre.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
