#!/bin/sh
set -eu

if [ "${SKIP_SITEMAP_VALIDATION:-0}" = "1" ]; then
  echo "[pre-commit] validação de sitemap ignorada por SKIP_SITEMAP_VALIDATION=1"
  exit 0
fi

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

REPORT="${TMPDIR:-/tmp}/sitemap-validation-report.json"
python3 scripts/validate_sitemaps_precommit.py \
  --base-url "${SITEMAP_BASE_URL:-https://condominiosnapraia.com.br}" \
  --output "$REPORT"
